{
  "name": "dontpad-cli",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "description": "Command-line interface scaffold for Dontpad",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagnernogueira/dontpad.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dontpad": "./dist/index.cjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:binary": "node scripts/build-binary.mjs",
    "start": "node dist/index.cjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "ws": "^8.18.3",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "nexe": "^5.0.0-beta.4",
    "tsup": "^8.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
